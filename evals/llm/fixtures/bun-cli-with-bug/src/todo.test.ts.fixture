import { expect, test } from "bun:test";
import { add, render } from "./todo";

test("add appends an open item", () => {
    expect(add([], "milk")).toEqual([{ title: "milk", done: false }]);
});

test("render numbers items from 1", () => {
    expect(render(add(add([], "milk"), "eggs"))).toBe("1. [ ] milk\n2. [ ] eggs");
});
