{
    "name": "craftpath",
    "version": "0.5.1",
    "description": "A repo-native engineering harness for coding agents. Runs on Claude Code and pi.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saculo/craftpath.git"
    },
    "homepage": "https://github.com/saculo/craftpath#readme",
    "bugs": {
        "url": "https://github.com/saculo/craftpath/issues"
    },
    "keywords": [
        "claude-code",
        "pi",
        "coding-agent",
        "agent-harness",
        "tdd",
        "cli",
        "bun"
    ],
    "type": "module",
    "bin": {
        "craftpath": "./bin/craftpath.ts"
    },
    "files": [
        "bin/",
        "src/",
        "assets/",
        "!src/**/*.test.ts",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "lint": "biome ci . --error-on-warnings",
        "format": "biome check . --write",
        "coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun evals/coverage/gate.ts",
        "check": "bun run lint && bun run typecheck && bun run coverage"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/bun": "latest",
        "typescript": "^7"
    }
}
